# Vorlage für .env (Zugang für deploy.sh). Kopieren: cp .env.beispiel .env
# .env wird nicht versioniert. Keine Passwörter hier hinein:
# SSH nutzt den Schlüssel aus ~/.ssh/config, FTPS das Passwort aus ~/.netrc oder die Eingabe.

# Weg A (bevorzugt): rsync über SSH, wenn der KAS-Tarif SSH hat
ZUGANG=ssh
SSH_HOST=lurohome-kas
ZIEL=lurohome.de/          # Ordner der Domain auf dem Server, steht im KAS unter Domain → bearbeiten

# Weg B: FTPS mit eigenem FTP-Benutzer nur für den Ordner dieser Domain
#ZUGANG=ftps
#FTP_HOST=w0123456.kasserver.com
#FTP_USER=w0123456_f1
#ZIEL=/              # der FTP-Benutzer sieht nur den Ordner der Domain
