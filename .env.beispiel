# Vorlage für .env (Zugang für deploy.sh). Kopieren: cp .env.beispiel .env
# .env wird nicht versioniert. Keine Passwörter hier hinein: Das FTP-Passwort liegt im
# macOS-Schlüsselbund, Dienst web-ftp-lurohome.de, Konto = FTP_USER. Anlegen (fragt nach dem Passwort):
#   security add-generic-password -U -a f01928aa -s web-ftp-lurohome.de -w

# FTPS mit dem FTP-Benutzer nur für den Ordner /lurohome.de/ (ALL-INKL hat in diesem Tarif kein SSH)
ZUGANG=ftps
FTP_HOST=v119013.kasserver.com
FTP_USER=f01928aa
ZIEL=/              # der FTP-Benutzer sieht nur den Ordner der Domain

# Falls es später SSH gibt: rsync über SSH
#ZUGANG=ssh
#SSH_HOST=allinkl-kas   # Eintrag in ~/.ssh/config
#ZIEL=lurohome.de/
